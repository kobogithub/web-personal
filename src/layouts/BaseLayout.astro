---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import EntryGate from '../components/EntryGate.astro';
import { loadEnv } from 'vite';
import type { Lang } from '@src/i18n/index';

// Prefijo `PUBLIC_` a propósito: acota loadEnv a las variables que son públicas
// por diseño. Un prefijo vacío cargaría todo el entorno, y cualquier secreto
// quedaría a un import de distancia de terminar en un bundle de cliente.
const { PUBLIC_GTAG_MEASUREMENT_ID: GTAG_MEASUREMENT_ID } = loadEnv(process.env.NODE_ENV || 'production', process.cwd(), 'PUBLIC_');
const { title, description, image, lang = 'es', alternateUrl, alternateLang } = Astro.props as { 
	title: string; 
	description: string; 
	image?: string; 
	lang?: Lang;
	alternateUrl?: string;
	alternateLang?: string;
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead 
			title={title} 
			description={description} 
			image={image} 
			lang={lang}
			alternateUrl={alternateUrl}
			alternateLang={alternateLang}
		/>
	</head>
	<body
		class="bg-magi-bg text-magi-ink pt-16 sm:pt-0"
	>
		<div class="magi-bg-fx" aria-hidden="true"></div>
		<div id="site-content">
			<Header lang={lang}/>
			<main class='py-8 min-h-[calc(100vh-160px)]'>
				<slot />
			</main>
			<Footer lang={lang} />
		</div>
		<EntryGate lang={lang} />
		<script is:inline>
			(function () {
				function runAssemble() {
					var els = Array.prototype.slice.call(document.querySelectorAll('.assemble'));
					if (!els.length) return;
					var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					if (reduced) {
						els.forEach(function (el) {
							el.classList.add('is-assembled');
						});
						return;
					}
					if (!('IntersectionObserver' in window)) {
						els.forEach(function (el) {
							el.classList.add('is-assembled');
						});
						return;
					}
					// Delay is assigned per intersection batch (not up front), sorted top-to-bottom,
					// so elements cascade in reading order instead of just by DOM-parent grouping.
					var io = new IntersectionObserver(
						function (entries) {
							var visible = entries
								.filter(function (entry) {
									return entry.isIntersecting;
								})
								.map(function (entry) {
									return entry.target;
								});
							if (!visible.length) return;
							visible.sort(function (a, b) {
								return a.getBoundingClientRect().top - b.getBoundingClientRect().top;
							});
							visible.forEach(function (el, i) {
								el.style.setProperty('--assemble-delay', Math.min(i * 70, 420) + 'ms');
								el.classList.add('is-assembled');
								io.unobserve(el);
							});
						},
						{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
					);
					els.forEach(function (el) {
						io.observe(el);
					});
				}

				// While the MAGI entry gate is about to open, hold off assembling the
				// page behind it until the doors finish sliding apart (see EntryGate.astro).
				if (window.__magiGatePending) {
					document.addEventListener('magi:gate-opened', runAssemble, { once: true });
				} else {
					runAssemble();
				}
			})();
		</script>
		<!-- Google tag (gtag.js) -->
    {
      GTAG_MEASUREMENT_ID &&
      <>
        <script type='text/partytown' async src={'https://www.googletagmanager.com/gtag/js?id=' + GTAG_MEASUREMENT_ID}></script>
        <script type='text/partytown' define:vars={{ GTAG_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());

          gtag('config', GTAG_MEASUREMENT_ID);
        </script>
      </>
    }
	</body>
</html>

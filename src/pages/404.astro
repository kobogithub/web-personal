---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
---

<!-- Esta página ya es bilingüe: no existe `/en/404/`, así que el switcher
     manda al home en inglés en vez de a una ruta inexistente. -->
<BaseLayout
	title={'404 · Señal perdida — ' + SITE_TITLE}
	description={SITE_DESCRIPTION}
	alternateUrl='/en/'
	alternateLang='en'
>
	<div class='container'>
		<div
			class='assemble corner-mark border border-magi-line border-t-2 border-t-magi-danger bg-magi-surface max-w-xl mx-auto my-16 p-8 text-center'
			data-dir='up'
		>
			<p class='eyebrow mb-4'>MAGI SYSTEM // ERROR 404</p>
			<h1 class='font-display font-bold uppercase tracking-tight text-7xl text-magi-danger mb-4'>404</h1>
			<p class='typewriter-cursor font-mono text-sm text-magi-ink mb-2'>
				SEÑAL PERDIDA — la página que buscás no existe o fue movida.
			</p>
			<p class='font-mono text-xs text-magi-muted mb-8'>
				Signal lost — the page you're looking for doesn't exist or was moved.
			</p>
			<Button href='/'>Volver al inicio</Button>
		</div>
	</div>
</BaseLayout>

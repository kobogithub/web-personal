---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { slugify, unslugify, inLang } from '@src/utils';
import PostsByYear from '@src/components/PostsByYear.astro';

type BlogPost = CollectionEntry<'blog'>;
export const getStaticPaths = async () => {
	const allPosts: BlogPost[] = await getCollection('blog');
	return [
		...new Set(
			allPosts
				.map((post) => post.data.tags)
				.flat()
				.filter((tag) => !!tag)
		)
	].map((tag) => ({ params: { tag: slugify(tag || '') } }));
};

const { tag } = Astro.params;
const lang = 'es';
// getStaticPaths sigue mirando la colección entera a propósito: así existen las
// dos páginas del tag y el switcher de idioma nunca apunta a una ruta ausente.
// Lo que se filtra es lo que se LISTA.
const allPosts: BlogPost[] = inLang(await getCollection('blog'), lang).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const taggedPosts = allPosts.filter((post) => post.data.tags?.map((t: string) => slugify(t)).includes(tag || ''));
const title = `All Posts Tagged with ${unslugify(tag || '')}`;
const description = `All Posts Tagged with ${unslugify(tag || '')}`;
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	alternateUrl={`/en/tags/${tag}/`}
	alternateLang="en"
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-display font-bold uppercase tracking-tight mb-2">{title}</h1>
    </div>
    <PostsByYear posts={taggedPosts} lang={lang}/>
  </div>
</BaseLayout>

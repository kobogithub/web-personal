---
import BaseLayout from '@src/layouts/BaseLayout.astro';
import ProjectList from '@src/components/ProjectList.astro';
import { projects } from '@src/pages/projects/projects';
import { useContentTranslations } from '@src/i18n/translations';

const lang = 'en';
const tc = useContentTranslations(lang);
---

<BaseLayout
	title={tc('projects.title')}
	description={tc('projects.description')}
	lang={lang}
	alternateUrl="/projects/"
	alternateLang="es"
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-display font-bold uppercase tracking-tight mb-2">{tc('projects.title')}</h1>
      <p class="text-magi-muted text-lg">{tc('projects.subtitle')}</p>
    </div>
    <ProjectList projects={projects} lang={lang}/>
  </div>
</BaseLayout>

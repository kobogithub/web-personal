---
import { Image } from 'astro:assets';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '@src/components/Prose.astro';
import { useContentTranslations } from '@src/i18n/translations';

const lang = 'en';
const tc = useContentTranslations(lang);
---

<BaseLayout
	title={tc('about.title')}
	description={tc('about.description')}
	lang={lang}
	alternateUrl="/about/"
	alternateLang="es"
>
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <h1 class="text-4xl font-bold mb-4">{tc('about.greeting')}</h1>
            <Prose>
              <div class="text-lg">
                <p>{tc('about.intro.p1')}</p>
                <p>{tc('about.intro.p2')}</p>  
              </div>
            </Prose>
          </div>
          <Image src={Ava} alt="Kevin Barroso" width={300}  class="rounded-3xl rotate-3 mx-4 md:mx-0"/>
        </div>     
        <div class="mt-12">
          <h2 class="text-3xl font-bold mb-8">{tc('about.workExperience')}</h2>
          
          <div class="space-y-10">
            <!-- Current job -->
            <div class="border-l-4 border-blue-500 pl-4">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Taligent</h3>
                <span class="text-sm text-gray-600 dark:text-gray-400">
                  {tc('about.taligent.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-blue-600 dark:text-blue-400 mb-2">
                {tc('about.taligent.position')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.taligent.task1')}</li>
                <li>{tc('about.taligent.task2')}</li>
                <li>{tc('about.taligent.task3')}</li>
                <li>{tc('about.taligent.task4')}</li>
                <li>{tc('about.taligent.task5')}</li>
                <li>{tc('about.taligent.task6')}</li>
                <li>{tc('about.taligent.task7')}</li>
              </ul>
            </div>

            <!-- Previous job -->
            <div class="border-l-4 border-blue-500 pl-4">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Freelance</h3>
                <span class="text-sm text-gray-600 dark:text-gray-400">
                  {tc('about.freelance.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-blue-600 dark:text-blue-400 mb-2">
                {tc('about.freelance.position')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.freelance.task1')}</li>
                <li>{tc('about.freelance.task2')}</li>
                <li>{tc('about.freelance.task3')}</li>
                <li>{tc('about.freelance.task4')}</li>
                <li>{tc('about.freelance.task5')}</li>
                <li>{tc('about.freelance.task6')}</li>
                <li>{tc('about.freelance.task7')}</li>
                <li>{tc('about.freelance.task8')}</li>
                <li>{tc('about.freelance.task9')}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="mt-12">
          <h2 class="text-3xl font-bold mb-8">{tc('about.certifications')}</h2>
          
          <div class="space-y-6">
            <div class="border border-gray-300 dark:border-gray-700 rounded-lg p-6 hover:shadow-lg transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                    {tc('about.cert.aws.title')}
                  </h3>
                  <p class="text-base text-gray-700 dark:text-gray-300 mb-1">
                    {tc('about.cert.aws.issuer')}
                  </p>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                    {tc('about.cert.aws.date')}
                  </p>
                  <a 
                    href="https://www.credly.com/badges/9d6d2abb-b604-44af-b658-cbbe24de0d28"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 font-medium"
                  >
                    {tc('about.cert.verify')}
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                </div>
                <div class="ml-4 flex-shrink-0">
                  <img 
                    src="https://images.credly.com/size/340x340/images/0e284c3f-5164-4b21-8660-0d84737941bc/image.png" 
                    alt="AWS Certified Solutions Architect - Associate badge"
                    class="w-24 h-24 object-contain"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
        </article>
    </main>
  </div>
</BaseLayout>

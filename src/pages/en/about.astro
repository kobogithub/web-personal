---
import { Image } from 'astro:assets';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '@src/components/Prose.astro';
import { useContentTranslations } from '@src/i18n/translations';
import CertificationList from '@src/components/CertificationList.astro';

const lang = 'en';
const tc = useContentTranslations(lang);
---

<BaseLayout
	title={tc('about.title')}
	description={tc('about.description')}
	lang={lang}
	alternateUrl="/about/"
	alternateLang="es"
>
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='w-full md:flex md:items-center gap-16 mb-10'>
          <div class="text-pretty leading-9">
            <p class="eyebrow mb-2">{tc('about.workExperience')}</p>
            <h1 class="text-4xl font-display font-bold uppercase tracking-tight mb-4">{tc('about.greeting')}</h1>
            <Prose>
              <div class="text-lg">
                <p>{tc('about.intro.p1')}</p>
                <p>{tc('about.intro.p2')}</p>  
              </div>
            </Prose>
          </div>
          <div class="corner-mark border border-magi-line p-1.5 mx-4 md:mx-0 w-fit shrink-0">
            <Image src={Ava} alt="Kevin Barroso" width={300} class="grayscale-[15%]"/>
          </div>
        </div>
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.workExperience')}</h2>
          
          <div class="space-y-10">
            <!-- Current job -->
            <div class="border-l-4 border-magi-accent pl-4">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Taligent</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.taligent.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.taligent.position')}
              </p>
              <div class="space-y-4">
                {[
                  { group: 'platform', tasks: 5 },
                  { group: 'data', tasks: 5 },
                  { group: 'ai', tasks: 5 },
                  { group: 'product', tasks: 2 },
                ].map(({ group, tasks }) => (
                  <div>
                    <h4 class="text-sm font-display font-bold uppercase tracking-wide text-magi-muted mb-2">
                      {tc(`about.taligent.group.${group}` as any)}
                    </h4>
                    <ul class="list-disc list-inside space-y-2 text-base">
                      {Array.from({ length: tasks }, (_, i) => (
                        <li>{tc(`about.taligent.${group}${i + 1}` as any)}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>

            <!-- Previous job -->
            <div class="border-l-4 border-magi-accent pl-4">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Freelance</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.freelance.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.freelance.position')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.freelance.task1')}</li>
                <li>{tc('about.freelance.task2')}</li>
                <li>{tc('about.freelance.task3')}</li>
                <li>{tc('about.freelance.task4')}</li>
                <li>{tc('about.freelance.task5')}</li>
                <li>{tc('about.freelance.task6')}</li>
                <li>{tc('about.freelance.task7')}</li>
                <li>{tc('about.freelance.task8')}</li>
                <li>{tc('about.freelance.task9')}</li>
                <li>{tc('about.freelance.task10')}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Teaching -->
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.teaching')}</h2>
          
          <div class="space-y-10">
            <div class="border-l-4 border-magi-accent pl-4">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">{tc('about.utn.company')}</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.utn.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.utn.position')}
              </p>
              <p class="text-base mb-2">
                {tc('about.utn.summary')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.utn.task1')}</li>
                <li>{tc('about.utn.task2')}</li>
                <li>{tc('about.utn.task3')}</li>
                <li>{tc('about.utn.task4')}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.certifications')}</h2>
          
          <CertificationList lang={lang} />
        </div>
        </article>
    </main>
  </div>
</BaseLayout>

---
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostsByYear from '@src/components/PostsByYear.astro';
import { slugify, inLang } from '@src/utils';

type BlogPost = CollectionEntry<'blog'>;

const lang = 'en';

export async function getStaticPaths() {
	const allPosts: BlogPost[] = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter((tag): tag is string => tag !== undefined);

	return uniqueTags.map((tag) => {
		// El tag se busca sobre la colección entera para que existan las dos
		// páginas del tag, pero solo se listan los posts en inglés: uno en
		// español linkeado desde acá daría `/en/{slug-es}/`, que no existe.
		const filteredPosts = inLang(allPosts, 'en').filter((post) => post.data.tags?.includes(tag));
		return {
			params: { tag: slugify(tag) },
			props: { posts: filteredPosts, tag }
		};
	});
}

type Props = {
	posts: BlogPost[];
	tag: string;
};

const { posts, tag } = Astro.props;
const sortedPosts = posts.sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tagSlug = Astro.params.tag;
---

<BaseLayout
	title={`Tag: ${tag}`}
	description={`All posts tagged with ${tag}`}
	lang={lang}
	alternateUrl={`/tags/${tagSlug}/`}
	alternateLang="es"
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-display font-bold uppercase tracking-tight mb-2">
        Tag: <span class="text-magi-accent">{tag}</span>
      </h1>
      <p class="text-magi-muted text-lg">
        {sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''} tagged with "{tag}"
      </p>
      <a href="/en/tags/" class="text-magi-violet hover:text-magi-accent hover:underline mt-4 inline-block">
        ← All tags
      </a>
    </div>
    <PostsByYear posts={sortedPosts} lang={lang}/>
  </div>
</BaseLayout>

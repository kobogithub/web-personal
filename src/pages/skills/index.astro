---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillsList from '../../components/SkillsList.astro';
import { getLocalizedSkills } from './skills';
import { useContentTranslations } from '@src/i18n/translations';

const lang = 'es';
const tc = useContentTranslations(lang);
const localizedSkills = getLocalizedSkills(lang);
---

<BaseLayout
	title="All My Skills"
	description="All my skills "
	lang="es"
	alternateUrl="/en/skills/"
	alternateLang="en"
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-display font-bold uppercase tracking-tight mb-2">{tc('skills.title')}</h1>
      <p class="text-magi-muted text-lg">{tc('skills.subtitle')}</p>
    </div>
    <SkillsList skills={localizedSkills}/>
  </div>
</BaseLayout>

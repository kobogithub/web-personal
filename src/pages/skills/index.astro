---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillsList from '../../components/SkillsList.astro';
import { getLocalizedSkills } from './skills';
import { useContentTranslations } from '@src/i18n/translations';

const lang = 'es';
const tc = useContentTranslations(lang);
const localizedSkills = getLocalizedSkills(lang);
---

<BaseLayout
	title={tc('skills.title')}
	description={tc('skills.description')}
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-bold mb-2">{tc('skills.title')}</h1>
      <p class="text-zinc-700 dark:text-zinc-300 text-lg">{tc('skills.subtitle')}</p>
    </div>
    <SkillsList skills={localizedSkills}/>
  </div>
</BaseLayout>

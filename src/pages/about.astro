---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { useContentTranslations } from '@src/i18n/translations';

const lang = 'es';
const tc = useContentTranslations(lang);
---

<BaseLayout
	title={tc('about.title')}
	description={tc('about.description')}
	lang={lang}
	alternateUrl="/en/about/"
	alternateLang="en"
>
  <div class='container'>
		<main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='assemble w-full md:flex md:items-center gap-16 mb-10' data-dir='up'>
          <div class="text-pretty leading-9">
            <p class="eyebrow mb-2">{tc('about.workExperience')}</p>
            <h1 class="text-4xl font-display font-bold uppercase tracking-tight mb-4">{tc('about.greeting')}</h1>
            <Prose>
              <div class="text-lg">
                <p>{tc('about.intro.p1')}</p>
                <p>{tc('about.intro.p2')}</p>
              </div>
            </Prose>
          </div>
          <div class="corner-mark assemble border border-magi-line p-1.5 mx-4 md:mx-0 w-fit shrink-0" data-dir="right">
            <Image src={Ava} alt="Kevin Barroso" width={300} class="grayscale-[15%]"/>
          </div>
        </div>
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.workExperience')}</h2>

          <div class="space-y-10">
            <!-- Trabajo actual -->
            <div class="border-l-4 border-magi-accent pl-4 assemble" data-dir="left">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Taligent</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.taligent.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.taligent.position')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.taligent.task1')}</li>
                <li>{tc('about.taligent.task2')}</li>
                <li>{tc('about.taligent.task3')}</li>
                <li>{tc('about.taligent.task4')}</li>
                <li>{tc('about.taligent.task5')}</li>
                <li>{tc('about.taligent.task6')}</li>
                <li>{tc('about.taligent.task7')}</li>
                <li>{tc('about.taligent.task8')}</li>
                <li>{tc('about.taligent.task9')}</li>
                <li>{tc('about.taligent.task10')}</li>
                <li>{tc('about.taligent.task11')}</li>
                <li>{tc('about.taligent.task12')}</li>
                <li>{tc('about.taligent.task13')}</li>
                <li>{tc('about.taligent.task14')}</li>
                <li>{tc('about.taligent.task15')}</li>
              </ul>
            </div>

            <!-- Trabajo anterior (ejemplo) -->
            <div class="border-l-4 border-magi-accent pl-4 assemble" data-dir="left">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">Freelance</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.freelance.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.freelance.position')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.freelance.task1')}</li>
                <li>{tc('about.freelance.task2')}</li>
                <li>{tc('about.freelance.task3')}</li>
                <li>{tc('about.freelance.task4')}</li>
                <li>{tc('about.freelance.task5')}</li>
                <li>{tc('about.freelance.task6')}</li>
                <li>{tc('about.freelance.task7')}</li>
                <li>{tc('about.freelance.task8')}</li>
                <li>{tc('about.freelance.task9')}</li>
                <li>{tc('about.freelance.task10')}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Docencia -->
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.teaching')}</h2>

          <div class="space-y-10">
            <div class="border-l-4 border-magi-accent pl-4 assemble" data-dir="left">
              <div class="flex justify-between items-center">
                <h3 class="text-xl font-semibold">{tc('about.utn.company')}</h3>
                <span class="text-sm text-magi-muted font-mono">
                  {tc('about.utn.period')}
                </span>
              </div>
              <p class="text-lg font-medium text-magi-accent mb-2">
                {tc('about.utn.position')}
              </p>
              <p class="text-base mb-2">
                {tc('about.utn.summary')}
              </p>
              <ul class="list-disc list-inside space-y-2 text-base">
                <li>{tc('about.utn.task1')}</li>
                <li>{tc('about.utn.task2')}</li>
                <li>{tc('about.utn.task3')}</li>
                <li>{tc('about.utn.task4')}</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Certificaciones -->
        <div class="mt-12">
          <h2 class="section-title mb-8">{tc('about.certifications')}</h2>

          <div class="space-y-6">
            <div class="corner-mark assemble border border-magi-line p-6 hover:border-magi-accent transition-colors" data-dir="up">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="text-xl font-semibold text-magi-ink mb-2">
                    {tc('about.cert.aws.title')}
                  </h3>
                  <p class="text-base text-magi-muted mb-1">
                    {tc('about.cert.aws.issuer')}
                  </p>
                  <p class="text-sm text-magi-muted font-mono mb-4">
                    {tc('about.cert.aws.date')}
                  </p>
                  <a
                    href="https://www.credly.com/badges/9d6d2abb-b604-44af-b658-cbbe24de0d28"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-magi-violet hover:text-magi-accent font-medium"
                  >
                    {tc('about.cert.verify')}
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                </div>
                <div class="ml-4 flex-shrink-0">
                  <img 
                    src="https://images.credly.com/size/340x340/images/0e284c3f-5164-4b21-8660-0d84737941bc/image.png" 
                    alt="AWS Certified Solutions Architect - Associate badge"
                    class="w-24 h-24 object-contain"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
        </article>
    </main>
  </div>
</BaseLayout>

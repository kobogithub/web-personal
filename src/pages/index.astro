---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '../components/Prose.astro';
import { projects } from './projects/projects';
import ProjectList from '../components/ProjectList.astro'
import SkillsList from '../components/SkillsList.astro'
import PostItem from '../components/PostItem.astro';
import { getLocalizedSkills } from '../pages/skills/skills.ts';
import { useTranslations } from '@src/i18n/index';
import { useContentTranslations } from '@src/i18n/translations';

type BlogPost = CollectionEntry<'blog'>;

const lang = 'es';
const t = useTranslations(lang);
const tc = useContentTranslations(lang);

const top6Projects = projects.slice(0, 6);
const top6Skills = getLocalizedSkills('es').slice(0, 6);
const posts = (await getCollection('blog', ({ data }: BlogPost) => data.lang === 'es')).sort((a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---

<BaseLayout 
	title={t('site.title') + ' - ' + t('site.tagline')} 
	description={t('site.description')}
	lang={lang}
	alternateUrl="/en/"
	alternateLang="en"
>
	<div class='container'>
		<div class='assemble w-full md:flex md:items-center gap-16 mb-10' data-dir='up'>
      <div class="text-pretty leading-9">
        <p class="eyebrow mb-2">{t('site.tagline')}</p>
        <h1 id="home-greeting" class="typewriter-cursor text-4xl font-display font-bold uppercase tracking-tight mb-4">{tc('home.greeting')}</h1>
        <Prose>
          <div class="text-lg">
            <p>{tc('home.intro.p1')}</p>
            <p>{tc('home.intro.p2')}</p>
          </div>
        </Prose>
      </div>
      <div class="corner-mark border border-magi-line p-1.5 mx-4 md:mx-0 w-fit shrink-0">
        <Image src={Ava} alt="Kevin Barroso" width={300} loading="eager" class="grayscale-[15%]"/>
      </div>
		</div>
		<script is:inline>
			(function () {
				var el = document.getElementById('home-greeting');
				if (!el) return;
				var original = el.textContent || '';
				var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (reduced) return;
				try {
					var chars = Array.from(original);
					el.textContent = '';
					var i = 0;
					(function type() {
						try {
							if (i <= chars.length) {
								el.textContent = chars.slice(0, i).join('');
								i++;
								setTimeout(type, 45);
							}
						} catch (e) {
							el.textContent = original;
						}
					})();
				} catch (e) {
					el.textContent = original;
				}
			})();
		</script>
		<main>
      <div class='mt-6 mb-12'>
        <div class="flex justify-between gap-2 border-b border-magi-line mb-1 pb-2">
          <h2 class="section-title">{tc('home.recentPosts')}</h2>
          <a href="/posts/" class="inline-block py-2 underline text-magi-violet hover:text-magi-accent">{tc('home.allPosts')} &raquo;</a>
        </div>
        <div>
          {
            posts.map((post: BlogPost) => (
              <PostItem post={post} lang={lang} />
            ))
          }      
        </div>
        <div class="text-right">
        </div>
      </div>
      <div class='mb-12'>
        <div class="flex justify-between gap-2 mb-4 border-b border-magi-line pb-2">
          <h2 class="section-title">{tc('home.myProjects')}</h2>
          <a href="/projects/" class="inline-block py-2 underline text-magi-violet hover:text-magi-accent">{tc('home.allProjects')} &raquo;</a>
        </div>
        <ProjectList projects={top6Projects} lang={lang}/>
      </div>
      <div>
        <div class="flex justify-between gap-2 mb-4 border-b border-magi-line pb-2">
          <h2 class="section-title">{tc('home.mySkills')}</h2>
          <a href="/skills/" class="inline-block py-2 underline text-magi-violet hover:text-magi-accent">{tc('home.allSkills')} &raquo;</a>
        </div>
        <SkillsList skills={top6Skills}/>
      </div>
		</main>
	</div>
</BaseLayout>

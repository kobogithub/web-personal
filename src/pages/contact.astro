---
import BaseLayout from '@src/layouts/BaseLayout.astro';
import ContactForm from '@src/components/ContactForm';
import Prose from '@src/components/Prose.astro';
import { useContentTranslations } from '@src/i18n/translations';
import LinkedInIcon from '@src/components/LinkedInIcon.astro';
import { SOCIAL_GITHUB, SOCIAL_LINKEDIN } from '@src/consts';

const lang = 'es';
const tc = useContentTranslations(lang);
---

<BaseLayout
	title={tc('contact.title')}
	description={tc('contact.description')}
	lang={lang}
	alternateUrl="/en/contact/"
	alternateLang="en"
>
  <div class='container'>
    <main class='prose text-lg dark:prose-invert'>
      <article>
        <div class='mb-10'>
          <h1 class="text-4xl font-display font-bold uppercase tracking-tight mb-6">{tc('contact.title')}</h1>
          <Prose>
            <div class="text-lg">
              <p class="mb-6">
                {tc('contact.intro.p1')}
              </p>
              <p class="mb-8">
                {tc('contact.intro.p2')}
              </p>
            </div>
          </Prose>
        </div>

        <!-- Formulario de contacto -->
        <div class="mb-12">
          <h2 class="section-title mb-4">{tc('contact.form.title')}</h2>
          <ContactForm client:load lang="es" />
        </div>

        <!-- Información adicional -->
        <div class="border-t border-magi-line pt-8">
          <h3 class="section-title mb-4">{tc('contact.help.title')}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <ul class="space-y-2">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.cloud')}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.kubernetes')}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.cicd')}
              </li>
            </ul>
            <ul class="space-y-2">
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.apis')}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.consulting')}
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 mr-3 text-magi-support" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {tc('contact.help.mentoring')}
              </li>
            </ul>
          </div>
        </div>

        <!-- Perfiles sociales -->
        <div class="border-t border-magi-line pt-8 mt-8">
          <h3 class="section-title mb-2">{tc('contact.connect.title')}</h3>
          <p class="text-base mb-4">{tc('contact.connect.text')}</p>
          <div class="flex flex-wrap gap-3 not-prose">
            <a
              href={SOCIAL_LINKEDIN}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-magi-line px-4 py-2 text-magi-muted hover:text-magi-accent hover:border-magi-accent transition-colors no-underline font-mono text-sm"
            >
              <LinkedInIcon size={18} />
              <span>LinkedIn</span>
            </a>
            <a
              href={SOCIAL_GITHUB}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-magi-line px-4 py-2 text-magi-muted hover:text-magi-accent hover:border-magi-accent transition-colors no-underline font-mono text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>

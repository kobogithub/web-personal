---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';

const lang = 'es';

export async function getStaticPaths() {
	const entries = await getCollection('projects', ({ data }: any) => data.lang === 'es' || !data.lang);
	return entries.map((entry: any) => ({
		// El id sale del `slug` del frontmatter. Las fichas en inglés usan el
		// mismo slug con sufijo `-en` para no colisionar dentro de la colección,
		// y la ruta `/en/` se lo saca para que ambas URLs queden simétricas.
		params: { slug: entry.id },
		props: entry,
	}));
}

const entry = Astro.props as CollectionEntry<'projects'>;
const { Content } = await render(entry);

const alternateEntry = entry.data.alternate
	? (await getCollection('projects')).find((e: any) => e.id === entry.data.alternate)
	: undefined;
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.summary}
	lang={lang}
	alternateUrl={alternateEntry ? `/en/projects/${alternateEntry.id.replace(/-en$/, '')}/` : undefined}
	alternateLang={alternateEntry ? 'en' : undefined}
>
	<ProjectDetail entry={entry} lang={lang}>
		<Content />
	</ProjectDetail>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { projects } from './projects';

---

<BaseLayout
	title="All My Projects"
	description="All my project portfolio from real projects to open source projects."
	lang="es"
	alternateUrl="/en/projects/"
	alternateLang="en"
>
  <div class='container'>
    <div class="mb-10">
      <h1 class="text-3xl font-bold mb-2">All My Projects</h1>
      <p class="text-zinc-700 dark:text-zinc-300 text-lg">Mi portafolio de proyectos comerciales y de código abierto.</p>
    </div>
    <ProjectList projects={projects}/>
  </div>
</BaseLayout>

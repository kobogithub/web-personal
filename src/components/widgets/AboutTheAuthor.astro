---
import Author from '../Author.astro';
import { useTranslations, type Lang } from '@src/i18n/index';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<div
	class='about-the-author py-4 border-b border-magi-line'
>
	<h3 class='eyebrow mb-4'>{t('author.title')}</h3>
	<Author picSize='md' />
	<div class='author-desc text-[.825rem] my-4 text-magi-muted'>
		<p class='mb-3'>
		{t('author.description')} <a href='https://aws.amazon.com/' target='_blank' class="underline text-magi-violet hover:text-magi-accent">AWS</a>
		</p>
	</div>
</div>



---
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/ava.jpg';
import LinkedInIcon from './LinkedInIcon.astro';
import { SOCIAL_GITHUB, SOCIAL_LINKEDIN } from '@src/consts';

type PicSize = 'sm' | 'md' | 'lg';
interface Props {
	picSize: PicSize;
}
const { picSize } = Astro.props;
---

<div class='flex gap-4 items-center leading-tight not-prose'>
	<a
		href={SOCIAL_GITHUB}
		target='_blank'
		rel='noopener noreferrer'
		class:list={[
			'rounded-full overflow-hidden shrink-0',
			{ 'w-12 h-12': picSize === 'sm' },
			{ 'w-[70px] h-[70px]': picSize === 'md' },
			{ 'w-[90px] h-[90px]': picSize === 'lg' }
		]}
	>
		<Image src={Ava} alt='Kevin Barroso' />
	</a>
	<div>
		<div>
			<a
				href={SOCIAL_GITHUB}
				class='block font-bold text-inherit hover:text-magi-accent'
				target='_blank'
				rel='noopener noreferrer'
			>
				Kevin Barroso
			</a>
		</div>
		<small class='avatar__subtitle'>Platform Manager / AI Engineer</small>
		<a
			href={SOCIAL_LINKEDIN}
			target='_blank'
			rel='noopener noreferrer'
			class='mt-1 flex items-center gap-1.5 text-magi-muted hover:text-magi-accent transition-colors no-underline'
			aria-label='LinkedIn'
		>
			<LinkedInIcon size={16} />
			<span class='text-xs font-mono'>LinkedIn</span>
		</a>
	</div>
</div>

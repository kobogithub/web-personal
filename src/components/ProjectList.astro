---
import { Image } from 'astro:assets';
import type { Project } from '../pages/projects/projects'
import type { Lang } from '../i18n/index'
import { kFormatter } from '../utils'
import GithubWhite from '@src/assets/img/github-mark-white.svg';
import GithubBlack from '@src/assets/img/github-mark.svg';

interface Props {
  projects: Project[];
  lang: Lang;
}

const { projects, lang } = Astro.props
---
<div class="grid grid-cols-12 gap-5">
  {
    projects.map((project: Project, index: number) =>
      <div
        class="corner-mark glow-accent assemble col-span-12 sm:col-span-6 lg:col-span-4 border border-magi-line border-t-2 border-t-magi-accent bg-magi-surface p-5 hover:-translate-y-1"
        data-dir={index % 2 === 0 ? 'left' : 'right'}
      >
        <div class="flex justify-between items-center">
          <div class='flex gap-2 flex-wrap'>
            {
              (project.tags || [] )?.map((tag: string) => (
                <span
                  class='border border-magi-line
                    text-xs font-mono text-magi-support no-underline px-2 py-0.5
                    transition-all duration-300
                  hover:border-magi-support'
                  >
                  {tag}
                </span>
              ))
            }
          </div>

          {project.stargazers_count !== undefined && (
            <div class='shrink-0'>
              <a
                href={project.html_url}
                target="_blank"
                class='border border-magi-line
                    text-xs font-mono text-magi-muted no-underline px-2 py-0.5
                    transition-all duration-300
                  hover:border-magi-accent hover:text-magi-accent
                    flex items-center gap-1
              '>
                <Image src={GithubBlack} height={12} class='dark:hidden' alt='Github stars' />
                <Image src={GithubWhite} height={12} class='hidden dark:block' alt='Github stars' />
                {kFormatter(project.stargazers_count)} stars
              </a>
            </div>
          )}
        </div>
        <h3 class="font-semibold my-2">
          <a class="underline hover:text-magi-accent" href={project.demoLink} target="_blank" rel={project.demoLinkRel}>{project.name[lang]}</a>
        </h3>
        <div class="line-clamp-2 text-magi-muted mb-4 min-h-[50px]">
          <p>{project.description[lang]}</p>
        </div>
        <div class="flex justify-end gap-3">
          {
            project.postLink &&
            <a class="underline text-magi-violet hover:text-magi-accent flex items-center gap-2" href={project.postLink}>
              Article
            </a>
          }
          <a class="underline text-magi-violet hover:text-magi-accent flex items-center gap-2" href={project.demoLink} target="_blank" rel={project.demoLinkRel}>
            Demo
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
        </div>
      </div>
    )
  }
</div>
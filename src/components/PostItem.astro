---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';
import { linkFor, type Lang } from '@src/i18n/index';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  post: BlogPost;
  lang?: Lang;
}

const { post, lang = 'es' } = Astro.props as Props;
---
<div class='assemble flex flex-col sm:flex-row gap-2 sm:items-center border-b border-magi-line py-2 mb-1 capitalize' data-dir='up'>
  <div class='text-magi-muted text-sm w-24 shrink-0 font-mono'>
    <FormattedDate date={post.data.pubDate} />
  </div>
  <h3 class='font-medium grow'>
    <a href={linkFor(lang, `${post.slug}/`)} class='hover:text-magi-accent transition-colors'>
      {post.data.title}
    </a>
  </h3>
  <div class='flex gap-2 shrink-0'>
    {
      (post.data.tags || [] )?.map((tag: string) => (
        <a
          class='border border-magi-line
          text-xs font-mono text-magi-support no-underline px-2 py-0.5
          transition-all duration-300
          hover:border-magi-support'
          href={linkFor(lang, `tags/${slugify(tag)}`)}>
          {tag}
        </a>
      ))
    }
  </div>
</div>
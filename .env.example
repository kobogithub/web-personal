# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y configura los valores necesarios
#
# Todas las variables llevan el prefijo PUBLIC_ porque su valor termina en el
# HTML publicado y no es secreto. El build solo lee variables con ese prefijo:
# una sin PUBLIC_ es invisible para el sitio, y eso es a propósito.
#
# No agregues secretos acá. Este es un sitio estático servido por GitHub Pages,
# sin runtime de servidor: cualquier valor que el build pueda leer es público.

# Google Analytics (opcional)
# Si no se proporciona, no se cargará Google Analytics
PUBLIC_GTAG_MEASUREMENT_ID=

# Giscus Comments (opcional)
# Si no se proporciona, los comentarios de Giscus no se mostrarán
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
